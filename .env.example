#General
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

#Server
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── LLM — Google Gemini (Primary — FREE from aistudio.google.com) ──────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_ADVANCED=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.2

# ── LLM — Groq (Ultra-Fast Free Fallback — console.groq.com) ───────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

#OCR & Document Intelligence
OCR_PROVIDER=gemini_vision
# GOOGLE_CLOUD_CREDENTIALS_PATH=./gcp-credentials.json  # Optional
# TESSERACT_CMD=/usr/bin/tesseract                      # Optional

#ASR — Speech-to-Text
ASR_PROVIDER=groq_whisper
WHISPER_MODEL=whisper-large-v3-turbo

#TTS — Text-to-Speech
TTS_PROVIDER=edge_tts

#Database
DATABASE_URL=sqlite+aiosqlite:///./medikiosk_dev.db
# DATABASE_URL=postgresql+asyncpg://medikiosk:password@localhost:5432/medikiosk

#Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800

#Security
SECRET_KEY=any random string of your choice
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

#Rate Limiting
RATE_LIMIT_PER_MINUTE=60

#File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
